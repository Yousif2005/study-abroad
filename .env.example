# ---------------------------------------------------------------------------
# Flow — environment template. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------
#
# There is deliberately NO OpenAI key here.
#
# Every model call is billed to the person who made it, using a key they enter
# themselves under Settings. A key in this file would mean the operator paying
# for other people's runs, and holding a credential they have no reason to hold.
#
# Without a key the app runs in demo mode: fully usable, nothing researched.
# ---------------------------------------------------------------------------

# Optional self-hosted key. Use one of these (never commit .env):
# OPENAI_API_KEY=sk-...
AGENTROUTER_API_KEY=sk-3sOP1rIX8Fu4JMHhA7sTlID0oO4XvEQaFjMnXKiqSsMvMBZS
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
LLM_PROVIDER=agentrouter
# AgentRouter uses its OpenAI-compatible Chat Completions endpoint. Choose a
# model available to your AgentRouter account, such as gpt-5.5 or glm-5.1.
# AgentRouter mode cannot run Flow prompts that enable OpenAI web search. Turn
# web search off in those prompts, or use a direct OpenAI key for research.
# For a hosted web-only deployment, also set LLM_PROVIDER=agentrouter in the
# server environment; visitors still provide their own key in Settings.

# Default models each stage falls back to. Any model the user's key can reach.
FLOW_RESEARCH_MODEL=gpt-5-mini
FLOW_ANALYSIS_MODEL=gpt-5-mini
FLOW_OUTREACH_MODEL=gpt-5.1

# --- Self-hosted only (the eight-service setup started by `npm run dev`) -----

GATEWAY_PORT=4000
PROFILES_PORT=4001
TARGETS_PORT=4002
PROMPTS_PORT=4003
RESEARCH_PORT=4004
ANALYSIS_PORT=4005
OUTREACH_PORT=4006
ORCHESTRATOR_PORT=4007

# Where the web app reaches the gateway.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the JSON document store lives.
FLOW_DATA_DIR=./data

# Loopback by default. There is no authentication, so this is what keeps the
# services private to this machine. Do not widen it on a shared network.
FLOW_BIND_HOST=127.0.0.1
FLOW_WEB_ORIGIN=http://localhost:3000

LOG_LEVEL=info

# --- Hosted deployment ------------------------------------------------------
# Set this one variable to run without any backend services. Each visitor's
# workspace and key then live in their own browser.
#
# NEXT_PUBLIC_FLOW_MODE=cloud
